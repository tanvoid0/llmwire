{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "extensionsToTreatAsEsm": [
    ".ts"
  ],
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "useESM": true
      }
    ]
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "testMatch": [
    "**/tests/unit-tests.ts",
    "**/tests/json-mode-and-usage.test.ts",
    "**/tests/streaming.test.ts",
    "**/tests/integration-local.ts",
    "**/tests/errors.test.ts",
    "**/tests/factory.test.ts",
    "**/tests/http.test.ts",
    "**/tests/providers-stream.test.ts",
    "**/tests/reasoning.test.ts",
    "**/tests/phase2.test.ts",
    "**/tests/messages.test.ts",
    "**/tests/prompt-cache.test.ts",
    "**/tests/tools.test.ts",
    "**/tests/schema.test.ts",
    "**/tests/agent.test.ts",
    "**/tests/routine.test.ts"
  ]
}
